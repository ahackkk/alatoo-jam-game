    \u043C\u043D\u0435 \u0441\u044B\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B...
    GTX \u0442\u044B\u0441\u044F\u0447\u0430 \u0448\u0435\u0441\u0442\u044C\u0441\u043E\u0442
    \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0441\u0443\u043F\u0435\u0440
    \u0438 intel core i \u0441\u0435\u043C\u044C."
  - "\u041C\u0430\u043C\u0430: \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0434\u043B\u044F
    \u0443\u0447\u0451\u0431\u044B \u043D\u0430\u0434\u043E."
  - "\u0414\u043B\u044F \u0443\u0447\u0451\u0431\u044B?"
  - "\u041C\u0430\u043C\u0430: \u041D\u0443 \u0434\u0430, \u0438 \u0435\u0449\u0451
    \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0440\u0435\u043D\u0434\u0435\u0440
    \u0441\u043A\u0430\u0447\u0430\u0442\u044C. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
    \u0431\u0435\u0437 \u044D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u0430\u043A."
  - "\u0420\u0435\u043D\u0434\u0435\u0440. \u0410\u0433\u0430. \u0423\u0447\u0451\u0431\u0430... "
  - "\u041C\u0430\u043C\u0430: \u0410 \u0435\u0449\u0451 \u0420\u043E\u0431\u043B\u043E\u043A\u0441!
    \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0420\u043E\u0431\u043B\u043E\u043A\u0441
    \u0442\u043E\u0436\u0435 \u0434\u043B\u044F \u0443\u0447\u0451\u0431\u044B."
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440.
    \u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u043E\u0431\u0435\u0440\u0451\u043C."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 1 \u0447\u0442\u043E\u0431\u044B:
    \u0427\u0435\u0441\u0442\u043D\u0430\u044F \u0446\u0435\u043D\u0430 \u2014 $320
    \U0001F4B0 \u041D\u0430\u0436\u043C\u0438\u0442\u0435 2 \u0447\u0442\u043E\u0431\u044B:
    \u0417\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u0446\u0435\u043D\u0430
    \u2014 $600"
