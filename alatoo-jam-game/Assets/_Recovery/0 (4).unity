  m_Script: {fileID: 11500000, guid: c15eb9fae3d3498409d52490fdf12c92, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 1400649498}
  lines:
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u041A\u0430\u043A \u0442\u0430\u043C
    \u043A\u043B\u0438\u0435\u043D\u0442?"
  - "\u0414\u043E\u0432\u043E\u043B\u0435\u043D!!"
  - "\u0411\u043E\u0441\u0441, \u0442\u0443\u0442 \u0434\u0435\u0442\u0430\u043B\u0435\u0439
    \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C..."
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u041D\u0443 \u0447\u0442\u043E \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0410 \u0445\u043E\u0442\u044F!"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0423 \u043D\u0430\u0441 \u043D\u0430
    \u0441\u043A\u043B\u0430\u0434\u0435 \u043A\u0443\u0447\u0443 \u043F\u0430\u043B\u0435\u043D\u044B\u0445
    \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u0431\u044B\u043B\u043E"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u041A\u0430\u043A \u0440\u0430\u0437
    \u043F\u043E\u0432\u043E\u0434 \u0440\u0430\u0441\u043F\u0440\u043E\u0434\u0430\u0442\u044C"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u044D\u0442\u043E..."
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0418\u0445 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F\u043C
    \u043D\u0435 \u0443\u0434\u0438\u0432\u043B\u044F\u0439\u0441\u044F"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
    \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443!"
