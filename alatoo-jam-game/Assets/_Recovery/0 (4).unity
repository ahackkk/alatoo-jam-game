--- !u!114 &1527044672
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1527044670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c15eb9fae3d3498409d52490fdf12c92, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 1067816135}
  lines:
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0421\u0442\u043E\u043F. \u0417\u0430\u043A\u0440\u043E\u0439
    \u0434\u0432\u0435\u0440\u044C."
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0417\u043D\u0430\u0435\u0448\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u044B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0432
    \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435?"
  - "\u041D\u0443... \u0431\u044B\u043B\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0445\u043E\u0440\u043E\u0448\u0438\u0445 \u0437\u0430\u043A\u0430\u0437\u043E\u0432,
    \u044F \u0434\u0443\u043C\u0430\u043B\u2014"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
    \u0442\u044B\u0441\u044F\u0447. \u041C\u0438\u043D\u0443\u0441 \u0430\u0440\u0435\u043D\u0434\u0430,
    \u043C\u0438\u043D\u0443\u0441 \u0437\u0430\u043A\u0443\u043F\u043A\u0430, \u043C\u0438\u043D\u0443\u0441
    \u043C\u043E\u0438 \u043D\u0435\u0440\u0432\u044B \u2014 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
    ... \u043D\u0438\u0447\u0435\u0433\u043E. \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C?
    \u041D\u043E\u043B\u044C."
  - "\u041D\u043E \u0434\u0435\u0442\u0430\u043B\u0438 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0430\u043B\u0438,
    \u0440\u044B\u043D\u043E\u043A \u0441\u0435\u0439\u0447\u0430\u0441\u2014"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0420\u044B\u043D\u043E\u043A. \u0422\u044B
    \u043C\u043D\u0435 \u043F\u0440\u043E \u0440\u044B\u043D\u043E\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C?"
  - "\u0412\u0438\u043A\u0442\u043E\u0440: [\u0434\u043E\u0441\u0442\u0430\u0451\u0442
    \u043A\u043E\u043D\u0432\u0435\u0440\u0442, \u0431\u0440\u043E\u0441\u0430\u0435\u0442
    \u043D\u0430 \u0441\u0442\u043E\u043B] \u042D\u0442\u043E \u0441\u0447\u0451\u0442
    \u0437\u0430 \u0430\u0440\u0435\u043D\u0434\u0443. \u041F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D
    \u043D\u0430 \u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430."
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0415\u0441\u043B\u0438 \u043A \u0432\u043E\u0441\u044C\u043C\u0438
    \u0432\u0435\u0447\u0435\u0440\u0430 \u0437\u0434\u0435\u0441\u044C \u043D\u0435
    \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043B\u0442\u043E\u0440\u044B \u0442\u044B\u0441\u044F\u0447\u0438
    \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u2014 \u0437\u0430\u0432\u0442\u0440\u0430
    \u0443\u0442\u0440\u043E\u043C \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u0442
    \u0437\u0430\u043C\u043E\u043A. \u0418 \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C
    \u0441\u0442\u043E\u044F\u0442\u044C \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C
    \u0441 \u043A\u043E\u0440\u043E\u0431\u043A\u043E\u0439 \u0441\u0432\u043E\u0438\u0445
    \u0432\u0435\u0449\u0435\u0439."
  - "\u041F\u043E\u043B\u0442\u043E\u0440\u044B \u0442\u044B\u0441\u044F\u0447\u0438?!
    \u0417\u0430 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u2014 \u044D\u0442\u043E
    \u043D\u0435\u0440\u0435\u0430\u043B\u044C\u043D\u043E\u2014 "
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u042D\u0442\u043E \u0442\u0432\u043E\u044F
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430. \u0423 \u0442\u0435\u0431\u044F
    \u0440\u0443\u043A\u0438, \u0443 \u0442\u0435\u0431\u044F \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B,
    \u0443 \u0442\u0435\u0431\u044F \u0441\u043A\u043B\u0430\u0434 \u0441 \u0436\u0435\u043B\u0435\u0437\u043E\u043C."
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u041B\u044E\u0434\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u0441\u044E\u0434\u0430 \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
    \u0438 \u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C. \u0427\u0442\u043E \u0442\u044B
    \u0438\u043C \u043F\u0440\u043E\u0434\u0430\u0448\u044C \u2014 \u044D\u0442\u043E
    \u0443\u0436\u0435 \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E, \u043C\u0430\u0441\u0442\u0435\u0440."
  - "\u0412\u0438\u043A\u0442\u043E\u0440: \u0418 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435."
